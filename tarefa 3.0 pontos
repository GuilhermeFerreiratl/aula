#include <stdio.h>
#include <string.h> 
#include <ctype.h>  
#include <stdlib.h> 

int main() {
    char senha_cadastrada[20]; 
    char senha_valida = 0;
    int senha_int;            
    int senha_digitada;
    float saldo = 500.00;
    float maior_deposito = 0.0;
    int opcao;
    float valor;
    
    printf("\n========================\n");
    printf("---BEM VINDO AO BANCO BITCOIN---\n");
    printf("========================\n");
    printf("=== CADASTRO DE SENHA ===\n");

    while (!senha_valida) {
        printf("Crie sua senha numerica de 4 digitos: ");
        scanf("%19s", senha_cadastrada); 

        if (strlen(senha_cadastrada) != 4) {
            printf("[ERRO] A senha deve ter exatamente 4 digitos!\n\n");
            continue;
        }

        int apenas_numeros = 1;
        for (int i = 0; i < 4; i++) {
            if (!isdigit(senha_cadastrada[i])) {
                apenas_numeros = 0;
                break;
            }
        }

        if (!apenas_numeros) {
            printf("[ERRO] A senha deve conter apenas numeros!\n\n");
        } else {
            senha_valida = 1; 
        }
    }


    senha_int = atoi(senha_cadastrada);

    printf("\nSenha cadastrada com sucesso!\n");
   
  
    do {
        printf("\n========================\n");
        printf("       MENU BANCO       \n");
        printf("========================\n");
        printf("1. Depositar\n");
        printf("2. Sacar\n");
        printf("3. Consultar Saldo\n");
        printf("4. Sair\n");
        printf("Escolha uma opcao: ");
        scanf("%d", &opcao);

        switch (opcao) {
            case 1:
                printf("\n--- DEPOSITO ---\n");
                printf("Digite o valor do deposito (R$): ");
                scanf("%f", &valor);

                if (valor <= 0) {
                    printf("Valor invalido!\n");
                } else {
                    saldo += valor;
                    
                    if (valor > maior_deposito) {
                        maior_deposito = valor;
                    }
                    printf("Deposito realizado com sucesso!\n");
                }
                break;

            case 2:
                printf("\n--- SAQUE ---\n");
                printf("Digite sua senha de 4 digitos para autorizar: ");
                scanf("%d", &senha_digitada);

                
                if (senha_digitada != senha_int) {
                    printf("Senha Incorreta! Operacao cancelada.\n");
                } else {
                    printf("Digite o valor do saque (R$): ");
                    scanf("%f", &valor);

                    if (valor <= 0) {
                        printf("Valor de saque invalido!\n");
                    } else if (valor > saldo) {
                        printf("Saldo Insuficiente!\n");
                    } else {
                        saldo -= valor;
                        printf("Saque realizado com sucesso!\n");
                    }
                }
                break;

            case 3:
                printf("\n--- SALDO  ---\n");
                printf("Saldo atual: R$ %.2f\n", saldo);
                printf("Maior deposito realizado: R$ %.2f\n", maior_deposito);
                break;

            case 4:
                printf("\nObrigado por usar nosso banco!\n");
                break;

            default:
                printf("\nOpcao invalida! Escolha uma opcao entre 1 e 4.\n");
        }

    } while (opcao != 4);

    return 0;
}
